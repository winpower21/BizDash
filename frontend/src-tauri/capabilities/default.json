{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "windows": [
        "*"
    ],
    "permissions": [
        "core:default",
        "opener:default",
        {
            "identifier": "opener:allow-open-path",
            "allow": [
                { "path": "$HOME/.bizdash/uploads/**" },
                { "path": "$HOME/AppData/Local/BizDash/uploads/**" }
            ]
        }
    ]
}